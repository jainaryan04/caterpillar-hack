# Copy to .env and fill in. .env is gitignored -- never commit real credentials.

# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Leave unset to run the API without persistence: planning still works, and the
# endpoints that read stored runs return 503 instead of pretending.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Default solver budget per pass, in seconds.
SCHEDULER_MAX_SECONDS=20
# Hard ceiling a request may ask for, so one call cannot pin the solver.
SCHEDULER_SECONDS_LIMIT=120

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
