# Copy to .env and restart `npx expo start -c`.
# Values are baked into the JS bundle: never put secrets here.

# Fleet Scheduler API (Prediction/): uvicorn api.main:app --host 0.0.0.0 --port 8000
#   Android emulator -> http://10.0.2.2:8000 · real phone -> http://<laptop LAN IP>:8000
EXPO_PUBLIC_FLEET_API_URL=http://10.0.2.2:8000

# Cat agent (cat_agent/): uv run main.py  (serves the phone API on :8765)
EXPO_PUBLIC_CAT_API_URL=http://10.0.2.2:8765

# 1 = ignore both servers and use the built-in mock data (demo without a laptop)
EXPO_PUBLIC_USE_MOCKS=0
