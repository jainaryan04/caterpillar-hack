# Speech-to-text (and text-to-speech by default)
DEEPGRAM_API_KEY=

# LLM (fast inference)
CEREBRAS_API_KEY=

# Manual search: OpenAI embeddings + Pinecone vector database
OPENAI_API_KEY=
PINECONE_API_KEY=

# Only needed if CAT_TTS_PROVIDER=cartesia
CARTESIA_API_KEY=

# Optional overrides (defaults shown)
# CAT_LLM_PROVIDER=cerebras          # or: openai
# CAT_LLM_MODEL=gpt-oss-120b         # openai default: gpt-4o-mini
# CAT_STT_MODEL=nova-3-general
# CAT_TTS_PROVIDER=deepgram          # or: cartesia
# CAT_TTS_VOICE=aura-2-helena-en     # Cartesia takes a voice ID

# Barge-in: talk over Cat to stop it. If Cat keeps cutting itself off on
# laptop speakers (the mic hears it), use headphones, raise the VAD values
# below, or set this to false.
# CAT_ALLOW_INTERRUPTIONS=true

# Echo guard: ignore Cat's own voice coming back through laptop speakers.
# Set false with headphones (barge-in reacts faster: ~0.5s instead of ~2s).
# CAT_ECHO_GUARD=true

# Silero VAD (runs locally)
# CAT_VAD_CONFIDENCE=0.7    # 0-1, how sure it must be that it's speech
# CAT_VAD_START_SECS=0.2    # speech needed before it counts as you talking
# CAT_VAD_STOP_SECS=0.2     # silence needed before you've stopped
# CAT_VAD_MIN_VOLUME=0.6    # 0-1, ignore quieter sounds

# Manual RAG (build the index with: uv run ingest_manual.py)
# CAT_PINECONE_INDEX=cat-320d-omm
# CAT_EMBED_MODEL=text-embedding-3-small
# CAT_RAG_TOP_K=5
# CAT_RAG_ALPHA=0.8         # 1 = meaning only, 0 = keywords only
# CAT_SHOW_IMAGES_LOCALLY=true  # also open manual pictures on this computer
